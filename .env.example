# ==== Telegram ====
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# ID чата/канала, куда слать авто-оповещения о сделках.
# Свой ID можно узнать у @userinfobot. Если оставить пустым — авто-скан не будет
# знать, куда слать, но команды в личке всё равно работают (после первого /start).
TELEGRAM_CHAT_ID=

# ==== Ключи площадок (опционально) ====
# Ключ CSFloat: csfloat.com -> Profile -> Developer / API key
CSFLOAT_API_KEY=
# Ключ market.csgo.com (TM Market). Прайс-лист работает и без него.
MARKET_CSGO_API_KEY=

# ==== Параметры сканирования ====
# Интервал авто-скана в секундах
SCAN_INTERVAL=60
# Сколько свежих листингов CSFloat забирать за проход (max 50)
SCAN_LIMIT=50
# По какому полю CSFloat отдаёт листинги: most_recent | lowest_price | highest_discount
SCAN_SORT_BY=most_recent

# ==== Фильтры выгодных сделок ====
# Минимальная прибыль в процентах, чтобы считать сделку интересной
MIN_PROFIT_PERCENT=10
# Минимальная абсолютная прибыль в USD
MIN_PROFIT_ABS=0.5
# Верхний потолок цены покупки в USD (0 = без ограничения)
MAX_BUY_PRICE=0
# Нижняя граница цены покупки в USD (отсекает копеечные скины)
MIN_BUY_PRICE=1

# ==== Ликвидность / стабильность ====
# Минимальный объём (кол-во продаж/лотов) на market.csgo для «ликвидного» скина
MIN_MARKET_VOLUME=20
# Минимальное кол-во листингов на CSFloat (reference.quantity) — тоже ликвидность
MIN_CSFLOAT_QUANTITY=10
# Отступ флоата от границы износа (0.0-0.05). Скины у самой границы нестабильны в цене.
FLOAT_EDGE_MARGIN=0.01

# ==== Комиссии площадок (доля, 0.05 = 5%) ====
# Комиссия продавца на CSFloat
CSFLOAT_FEE=0.02
# Комиссия market.csgo
MARKET_CSGO_FEE=0.05

# ==== Валюта ====
# Валюта отображения: EUR | USD | RUB. market.csgo берёт прайс сразу в ней.
CURRENCY=EUR
# Курс для конвертации цен CSFloat (они приходят в USD): сколько CURRENCY в 1 USD.
# Для EUR обычно ~0.92. Обнови при желании под актуальный курс.
USD_RATE=0.92

# ==== Категории предметов ====
# Показывать только оружие, ножи, перчатки и агентов. Стикеры, брелки (charms),
# граффити, кейсы, значки и прочее — не показывать.
WEAPONS_ONLY=true
# Не показывать сувенирное оружие
EXCLUDE_SOUVENIR=true
# (устаревшее, перекрыто WEAPONS_ONLY) не показывать стикеры
EXCLUDE_STICKERS=true

# ==== Актуальность ====
# Проверять перед отправкой, не купили ли лот (реальный запрос к CSFloat на
# каждый отправляемый оффер — их немного). Купленные авто-офферы не присылаются.
CHECK_LIVE_STATUS=true

# ==== Анализ стабильности цены ====
# Анализировать историю продаж CSFloat и писать, стабильная цена или скачет.
ANALYZE_STABILITY=true

# ==== Площадки покупки ====
# Искать предметы для покупки на CSFloat (основной источник)
CSFLOAT_ENABLED=true

# ==== Skinport ====
# Искать предметы для покупки на Skinport (публичный API, ключ НЕ нужен).
SKINPORT_ENABLED=true
# Ключ нужен только для приватных операций, для чтения цен — нет. Можно оставить пустым.
# ВПИШИ СВОЙ КЛЮЧ ЗДЕСЬ (файл .env в git не попадает). Никому не показывай.
SKINPORT_API_KEY=
# Крайний случай: отключить проверку SSL для Skinport, если у них просрочен
# сертификат. Небезопасно (возможна подмена цен) — включай только осознанно.
SKINPORT_INSECURE=false

# ==== CS.MONEY (экспериментально) ====
# Искать предметы для покупки ещё и на CS.MONEY. У них нет официального API и
# стоит защита от ботов — может не работать (тогда просто ничего не вернёт).
# По умолчанию выключено, чтобы не мешать основному потоку с CSFloat.
CSMONEY_ENABLED=false
